APP_NAME=GasAgent.ai API
CORS_ORIGINS=["*"]

# EV charging directory API key — https://developer.nlr.gov/signup
NREL_API_KEY=

# EV charging community-data API key — https://openchargemap.org/site/develop/api
OCM_API_KEY=

# US gas price trend data (forecast, US locations only) — https://www.eia.gov/opendata/register.php
# Optional: without a key, the forecast still works for Canadian locations
# (that trend source is free and keyless) but shows no regional trend
# for US locations.
EIA_API_KEY=

# LLM API key (Chat tab's AI agent) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Anti-bot solver endpoint — only set this if the gas-price lookup's
# anti-bot protection is blocking the deploy's own IP (CloudflareBlocked
# errors), typically from a datacenter/cloud host rather than a home
# connection. Leave unset for local dev; point at a co-located solver
# instance in production, e.g. http://127.0.0.1:8191/v1
# GASBUDDY_SOLVER_URL=

# How long (ms) to wait for the gas-price lookup/solver before giving up
# — defaults to 120000 (2 min), above the underlying client's own 60s
# default, since a harder/slower anti-bot challenge can genuinely take
# longer than that to solve. If raising this, also raise the solver's
# own BROWSER_TIMEOUT env var (on the solver's own deploy) to at least
# the same value — this setting alone doesn't help if the solver's own
# cap is still lower.
# GASBUDDY_TIMEOUT_MS=120000

# Optional: when a real gas search gets blocked by anti-bot protection,
# triggers a fresh redeploy of the solver's own hosted service in the
# background — the blocked search still returns its usual error right
# away, with the redeploy just improving the odds for whatever the user
# tries next. Not triggered on every app launch — a redeploy takes real
# time, so it's only worth paying for reactively, when it's actually
# needed. Confirmed live that a same-container *restart* alone was NOT
# enough, but a full redeploy (fresh container, plausibly a new egress
# IP) succeeded where the same long-running container kept failing.
# Leave both unset to disable this — a blocked search still returns its
# usual error either way, just without attempting a redeploy first.
#
# RENDER_API_KEY: create from your hosting provider's account settings
# FLARESOLVERR_SERVICE_ID: from the solver service's own dashboard URL,
# e.g. https://dashboard.render.com/web/srv-XXXXXXXXXXXX → srv-XXXXXXXXXXXX
# RENDER_API_KEY=
# FLARESOLVERR_SERVICE_ID=
