APP_NAME=GasAgent.ai API
CORS_ORIGINS=["*"]

# NREL Alternative Fuels Data Center API — https://developer.nlr.gov/signup
NREL_API_KEY=

# Open Charge Map API — https://openchargemap.org/site/develop/api
OCM_API_KEY=

# US EIA (gas price forecast, US locations only) — https://www.eia.gov/opendata/register.php
# Optional: without a key, the forecast still works for Canadian locations
# (Statistics Canada's API is free and keyless) but shows no regional
# trend for US locations.
EIA_API_KEY=

# Groq API (Chat tab's AI agent) — https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
