APP_NAME=GasAgent.ai API
CORS_ORIGINS=["*"]

# NREL Alternative Fuels Data Center API — https://developer.nlr.gov/signup
NREL_API_KEY=

# Open Charge Map API — https://openchargemap.org/site/develop/api
OCM_API_KEY=

# US EIA (gas price forecast, US locations only) — https://www.eia.gov/opendata/register.php
# Optional: without a key, the forecast still works for Canadian locations
# (Statistics Canada's API is free and keyless) but shows no regional
# trend for US locations.
EIA_API_KEY=

# Gemini API (Chat tab's AI agent) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# FlareSolverr endpoint — only set this if GasBuddy is blocking the
# deploy's own IP (CloudflareBlocked errors), typically from a
# datacenter/cloud host rather than a home connection. Leave unset for
# local dev; point at a co-located FlareSolverr instance in production,
# e.g. http://127.0.0.1:8191/v1
# GASBUDDY_SOLVER_URL=

# How long (ms) to wait for GasBuddy/FlareSolverr before giving up —
# defaults to 120000 (2 min), above py-gasbuddy's own 60s default, since
# a harder/slower Cloudflare challenge can genuinely take longer than
# that to solve. If raising this, also raise FlareSolverr's own
# BROWSER_TIMEOUT env var (on FlareSolverr's own deploy) to at least the
# same value — this setting alone doesn't help if FlareSolverr's own cap
# is still lower.
# GASBUDDY_TIMEOUT_MS=120000

# Optional: triggers a fresh redeploy of FlareSolverr's own Render
# service whenever a real gas search actually gets Cloudflare-blocked
# (not on every app launch — a redeploy takes real time, so it's only
# worth paying for reactively, when it's actually needed). Confirmed
# live that a same-container *restart* alone was NOT enough, but a full
# redeploy (fresh container, plausibly a new egress IP) succeeded where
# the same long-running container kept failing. Leave both unset to
# disable this — a blocked search still returns its usual error either
# way, just without attempting a redeploy first.
#
# RENDER_API_KEY: create at https://dashboard.render.com/u/settings#api-keys
# FLARESOLVERR_SERVICE_ID: from FlareSolverr's own service dashboard URL,
# e.g. https://dashboard.render.com/web/srv-XXXXXXXXXXXX → srv-XXXXXXXXXXXX
# RENDER_API_KEY=
# FLARESOLVERR_SERVICE_ID=
